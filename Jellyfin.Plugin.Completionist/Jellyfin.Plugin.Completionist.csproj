<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Pick the server line with -p:JellyfinTarget=10.11 (default: 12). -->
    <JellyfinTarget Condition="'$(JellyfinTarget)' == ''">12</JellyfinTarget>
    <TargetFramework Condition="'$(JellyfinTarget)' == '12'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(JellyfinTarget)' == '10.11'">net9.0</TargetFramework>
    <JellyfinPackageVersion Condition="'$(JellyfinTarget)' == '12'">12.0.0</JellyfinPackageVersion>
    <JellyfinPackageVersion Condition="'$(JellyfinTarget)' == '10.11'">10.11.0</JellyfinPackageVersion>
    <DefineConstants Condition="'$(JellyfinTarget)' == '10.11'">$(DefineConstants);JELLYFIN_10_11</DefineConstants>
    <RootNamespace>Jellyfin.Plugin.Completionist</RootNamespace>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Built against the first release of each line so it loads on every later minor version. -->
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinPackageVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinPackageVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.Completionist.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
